{
  "name": "designdeck",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "dotenv -e .env -- mvn -f apps/api/pom.xml spring-boot:run",
    "tf": "dotenv -e .env -- terraform -chdir=terraform/vercel",
    "tf:vercel": "dotenv -e .env -- terraform -chdir=terraform/vercel",
    "tf:neon": "dotenv -e .env.prod -- terraform -chdir=terraform/neon",
    "tf:render": "dotenv -e .env.prod -- terraform -chdir=terraform/render",
    "tf:vercel:prod": "dotenv --no-expand -e .env.prod -- terraform -chdir=terraform/vercel",
    "tf:neon:prod": "dotenv --no-expand -e .env.prod -- terraform -chdir=terraform/neon",
    "tf:render:prod": "dotenv --no-expand -e .env.prod -- terraform -chdir=terraform/render",
    "build": "npm run build:web",
    "build:web": "npm --workspace apps/web run build",
    "build:api": "mvn -f apps/api/pom.xml test",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:db": "docker compose -f docker-compose.dev.yml up -d",
    "lint": "npm --workspace apps/web run lint",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.7.3"
  }
}