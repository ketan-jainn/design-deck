# PostgreSQL (API)
DATABASE_URL=jdbc:postgresql://localhost:5432/designdeck
DATABASE_USERNAME=designdeck
DATABASE_PASSWORD=designdeck

# Redis (API)
REDIS_URL=redis://localhost:6379

# Auth (API)
JWT_SECRET=replace-with-a-long-random-secret

# Bazaarlink grading (API)
BAZAARLINK_API_KEY=
BAZAARLINK_MODEL=qwen/qwen3.7-flash:free

# Frontend URL for password reset links (API)
FRONTEND_URL=http://localhost:3000

# Email (API) — reset links log to API stdout when RESEND_API_KEY is unset
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
# Use an address on a domain verified with Resend. The fallback is a placeholder.
MAIL_FROM=
RESEND_API_KEY=

# Next.js BFF proxy target (Web)
API_BASE_URL=http://localhost:8080

# Set true only when the web app is served over HTTPS
COOKIE_SECURE=false

# Terraform: Vercel Hobby project (local use only; never commit real values)
VERCEL_API_TOKEN=
TF_VAR_vercel_team_id=
